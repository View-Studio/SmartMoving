{
  "schemaVersion": 1,
  "id": "smartmoving",
  "version": "${version}",
  "name": "SmartMoving",
  "description": "A Minecraft mod that enriches character movement. Fabric 1.21.1 port of the classic SmartMoving — climbing, crawling, sliding, head jump and more.",
  "authors": [
    "View-Studio"
  ],
  "contact": {
    "homepage": "https://github.com/View-Studio/SmartMoving",
    "sources": "https://github.com/View-Studio/SmartMoving",
    "issues": "https://github.com/View-Studio/SmartMoving/issues"
  },
  "license": "GPL-3.0-or-later",
  "icon": "assets/smartmoving/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "choco.ratel.smartmoving.SmartMoving"
    ],
    "client": [
      "choco.ratel.smartmoving.client.SmartMovingClient"
    ]
  },
  "mixins": [
    "smartmoving.mixins.json",
    {
      "config": "smartmoving.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
