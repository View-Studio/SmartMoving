{
  "schemaVersion": 1,
  "id": "smartmoving",
  "version": "${version}",
  "name": "SmartMoving",
  "description": "Akashic records system mod",
  "authors": [],
  "contact": {},
  "license": "All-Rights-Reserved",
  "icon": "assets/smartmoving/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "choco.ratel.smartmoving.client.SmartmovingDataGenerator"
    ],
